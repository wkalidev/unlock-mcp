{
  "name": "unlock-mcp",
  "version": "0.3.1",
  "description": "Read-only MCP server exposing Unlock Protocol on-chain state",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "unlock-protocol",
    "web3",
    "ethereum",
    "base",
    "nft",
    "membership",
    "blockchain"
  ],
  "license": "MIT",
  "author": "wkalidev",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "unlock-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wkalidev/unlock-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/wkalidev/unlock-mcp/issues"
  },
  "homepage": "https://github.com/wkalidev/unlock-mcp#readme",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "npm run build && node --test dist/tools/*.test.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "viem": "^2.56.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^20.0.0"
  }
}
